## Copy this file to .env and fill values.
## Required keys are marked REQUIRED. Others are optional.

# Environment Mode
# Valid values: local, staging, production
ENV_MODE=local

##### DATABASE (REQUIRED)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret from Supabase Dashboard > Project Settings > API > JWT Secret (REQUIRED for auth security)
SUPABASE_JWT_SECRET=

##### REDIS
# Use "redis" when using docker compose, or "localhost" for fully local
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Set false for local/docker compose
REDIS_SSL=false

##### LLM PROVIDERS (At least one is functionally REQUIRED)
# Provide at least one of the following:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# AWS Bedrock (only if using Bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=

##### AWS AGENTCORE (Optional; for AgentCore migration)
#
# Phase 1 Migration: Replaces Daytona+Stagehand with AgentCore Code Interpreter+Browser
# All AgentCore services MUST run in ap-southeast-2 (Australia) for data residency compliance.
#
# Environment: local, development, production
# Note: AgentCore is disabled in local environment (use Daytona for local development)
AGENTCORE_ENVIRONMENT=development

# AWS Configuration for AgentCore
# IMPORTANT: For Phase 1, MUST be ap-southeast-2 for data residency
AGENTCORE_AWS_REGION=ap-southeast-2
AGENTCORE_AWS_ACCESS_KEY_ID=
AGENTCORE_AWS_SECRET_ACCESS_KEY=

# Feature flags (default: true)
# Phase 1 requires: CODE_INTERPRETER_ENABLED=true and BROWSER_ENABLED=true
AGENTCORE_RUNTIME_ENABLED=true
AGENTCORE_MEMORY_ENABLED=true
AGENTCORE_CODE_INTERPRETER_ENABLED=true
AGENTCORE_BROWSER_ENABLED=true
AGENTCORE_GATEWAY_ENABLED=true

# S3 configuration for file storage
# IMPORTANT: For Phase 1, MUST be ap-southeast-2 for data residency
AGENTCORE_S3_BUCKET_NAME=
AGENTCORE_S3_BUCKET_REGION=ap-southeast-2

# Timeouts (in seconds)
AGENTCORE_RUNTIME_TIMEOUT_SECONDS=900
AGENTCORE_CODE_INTERPRETER_TIMEOUT_SECONDS=900
AGENTCORE_BROWSER_TIMEOUT_SECONDS=900
AGENTCORE_GATEWAY_TIMEOUT_SECONDS=60

# Session management
# AgentCore sessions are cached and reused until timeout
# Sessions are created per-project and per-type (code or browser)
AGENTCORE_SESSION_CACHE_ENABLED=true

# Session timeouts (in seconds)
# How long a session remains active before being cleaned up
AGENTCORE_CODE_INTERPRETER_SESSION_TIMEOUT_SECONDS=1800
AGENTCORE_BROWSER_SESSION_TIMEOUT_SECONDS=1800

# Memory limits (in MB)
# Maximum memory allocation for Code Interpreter sessions
AGENTCORE_CODE_INTERPRETER_MEMORY_LIMIT_MB=2048
AGENTCORE_RUNTIME_MEMORY_LIMIT_MB=2048

# Browser configuration
AGENTCORE_BROWSER_HEADLESS=true
AGENTCORE_BROWSER_RECORDING_ENABLED=false
AGENTCORE_BROWSER_RECORDING_S3_BUCKET=

# Memory configuration (Phase 3)
AGENTCORE_MEMORY_RETENTION_DAYS=90
AGENTCORE_MEMORY_MAX_MESSAGES=10000
AGENTCORE_MEMORY_SEMANTIC_SEARCH_ENABLED=true

# Gateway rate limiting (Phase 4)
AGENTCORE_GATEWAY_RATE_LIMIT_PER_MINUTE=100

# Retry configuration
AGENTCORE_RETRY_MAX_ATTEMPTS=3
AGENTCORE_RETRY_BASE_DELAY_SECONDS=1
AGENTCORE_RETRY_MAX_DELAY_SECONDS=60

# DynamoDB tables for Gateway (Phase 4)
AGENTCORE_DYNAMODB_MCP_CATALOG_TABLE=agentcore_mcp_catalog
AGENTCORE_DYNAMODB_OAUTH_STATES_TABLE=agentcore_oauth_states

# AWS Secrets Manager prefix for Gateway credentials
AGENTCORE_SECRETS_MANAGER_PREFIX=agentcore/gateway/

# Fallback configuration
# If true, falls back to Daytona when AgentCore fails
# If false, errors are raised when AgentCore is unavailable
AGENTCORE_FALLBACK_TO_LEGACY_SANDBOX=false

# Memory fallback
# If true, falls back to database memory when AgentCore Memory fails
AGENTCORE_FALLBACK_TO_DATABASE=true

# OpenAI-compatible
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_API_BASE=

##### DATA / SEARCH (REQUIRED)
RAPID_API_KEY=
TAVILY_API_KEY=

##### WEB SCRAPE (REQUIRED)
FIRECRAWL_API_KEY=
# Default used if empty: https://api.firecrawl.dev
FIRECRAWL_URL=

##### AGENT SANDBOX (REQUIRED to use Daytona sandbox)
DAYTONA_API_KEY=
DAYTONA_SERVER_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

##### SECURITY & WEBHOOKS (Recommended)
MCP_CREDENTIAL_ENCRYPTION_KEY=
TRIGGER_WEBHOOK_SECRET=

##### OBSERVABILITY (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

##### BILLING (Optional;)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_PLAN_ID=
STRIPE_DEFAULT_TRIAL_DAYS=14

##### ADMIN
KORTIX_ADMIN_API_KEY=

##### INTEGRATIONS
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
COMPOSIO_API_BASE=https://backend.composio.dev

##### GOOGLE INTEGRATIONS (Optional; for Google Slides upload)
# Google OAuth credentials for Google Slides integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

ZENDESK_AUTH_CONFIG=""
EXA_API_KEY=""

CHUNKR_API_KEY=""

SUPABASE_WEBHOOK_SECRET=
MAILTRAP_API_TOKEN=
MAILTRAP_SENDER_EMAIL=
MAILTRAP_SENDER_NAME=